require import AllCore Distr StdOrder.
require import NTRUPlus768AHState NTRUPlus768AHAdapter.
require import NTRUPlus768CCAOraclePorts NTRUPlus768CCAGame.
require import NTRUPlus768CCADecapOracle NTRUPlus768RawXOF NTRUPlus768RawXOFStreams.
require import NTRUPlus768ROMOracles NTRUPlus768SimModel.
require import NTRUPlus768CPAModel NTRUPlus768CPAReduction.
require import NTRUPlus768SecModel NTRUPlus768SecReduction NTRUPlus768SecBaseGames.
require import NTRUPlus768SecFinal NTRUPlus768SecGOracles.
require import NTRUPlus768OWGames NTRUPlus768OWReduction NTRUPlus768OWKeyConditioning.
require import NTRUPlus768INJGames NTRUPlus768INJReduction NTRUPlus768INJExistence.
require import NTRUPlus768SRBound.
import RealOrder RField.

(* These are the existing explicit reducers applied to the actual list
   wrapper. Their transcript is generated by that wrapper's own calls,
   including encryption calls made during the list scan. No equality
   with the former map scan's G-query history is asserted or assumed. *)
module AH_DI(S:AHStore,A:CCAExtendedAdversary) =
 INJNTRUReduction(SecINJAuxAdapter(SecINJReducer(AHWrapper(S,A)))).
module AH_DO(S:AHStore,A:CCAExtendedAdversary) =
 OWNTRUReduction(SecOWAuxAdapter(SecOWReducer(AHWrapper(S,A)))).
module AH_CO(S:AHStore,A:CCAExtendedAdversary) =
 OWRLWESolver(SecOWAuxAdapter(SecOWReducer(AHWrapper(S,A)))).

(* Only the original robust adversary losslessness is required. Store
   losslessness is discharged by the fresh local store at instantiation. *)
lemma ah_wrapper_lossless
 (S<:AHStore)(A<:CCAExtendedAdversary {-S})
 (O<:CCAExtendedOraclePort {-A})(D<:CCADecapPort {-A}) :
 islossless S.init=>islossless S.snapshot=>islossless S.record=>
 (forall(H<:CCAExtendedOraclePort {-A})(D0<:CCADecapPort {-A}),
 islossless H.e=>islossless H.f=>islossless H.g=>islossless H.h=>islossless H.raw=>
 islossless D0.decap=>islossless A(H,D0).guess)=>
 islossless O.e=>islossless O.f=>islossless O.g=>islossless O.h=>islossless O.raw=>
 islossless AHWrapper(S,A,O,D).guess.
proof.
 move=>hi hs hr all he hf hg hh hraw.
 have ha:=all (AHOracles(S,O)) (AHDecap(S,O)) he hf hg
  (ah_record_h_ll S O hh hr) (ah_oracles_raw_ll S O hh hraw hr)
  (ah_decap_ll S O hs hg).
 proc;call ha;call hi;call hf;auto.
qed.

lemma ah_hardness_sum (v i o di doo sr rl mass alpha:real) :
 0%r<alpha=>v<=i+o=>i<=(di+sr)/alpha=>o<=(doo+rl)/alpha=>sr<=mass=>
 v<=(di+mass)/alpha+(doo+rl)/alpha.
proof.
 move=>ha hv hi ho hs.
 have hm:(di+sr)/alpha<=(di+mass)/alpha.
 + rewrite ler_pmul2r 1:invr_gt0 1:ha;smt().
 smt().
qed.

(* Generic store exclusions establish that AHWrapper satisfies the
   existing CPA theorem's private-state contract. The final existential
   construction chooses this store after the original A, so it adds no
   new exclusion to that original adversary's public theorem. *)
lemma ah_cpa_hardness
 (S<:AHStore {-CPAReduction,-ROE,-ROF,-ROG,-ROH,-RawXOFStreams,
 -SimPublic,-SimHistory,-SecGHistory,-SecGMark})
 (A<:CCAExtendedAdversary {-S,-CPAReduction,-ROE,-ROF,-ROG,-ROH,-RawXOFStreams,
 -SimPublic,-SimHistory,-SecGHistory,-SecGMark}) &m :
 islossless S.init=>islossless S.snapshot=>islossless S.record=>
 (forall(H<:CCAExtendedOraclePort {-A})(D<:CCADecapPort {-A}),
 islossless H.e=>islossless H.f=>islossless H.g=>islossless H.h=>islossless H.raw=>
 islossless D.decap=>islossless A(H,D).guess)=>
 `|Pr[CPAGame(CPAReduction(AHWrapper(S,A))).run()@&m:res]-1%r/2%r|<=
 (Pr[OWNTRURealGame(AH_DI(S,A)).run()@&m:res]-
  Pr[OWNTRUUniformGame(AH_DI(S,A)).run()@&m:res]+1%r/(2%r^244))/ow_alpha_g+
 (Pr[OWNTRURealGame(AH_DO(S,A)).run()@&m:res]-
  Pr[OWNTRUUniformGame(AH_DO(S,A)).run()@&m:res]+
  Pr[OWRLWEGame(AH_CO(S,A)).run()@&m:res])/ow_alpha_g.
proof.
 move=>hi hs hr all.
 have hall:forall(H<:CCAExtendedOraclePort {-AHWrapper(S,A)})
  (D<:CCADecapPort {-AHWrapper(S,A)}),
  islossless H.e=>islossless H.f=>islossless H.g=>islossless H.h=>islossless H.raw=>
  islossless D.decap=>islossless AHWrapper(S,A,H,D).guess.
 + move=>H D he hf hg hh hraw hd.
   exact(ah_wrapper_lossless S A H D hi hs hr all he hf hg hh hraw).
 have hc:=sec_cpa_base (AHWrapper(S,A)) &m hall.
 have hinj:=inj_base_hardness (SecINJAuxAdapter(SecINJReducer(AHWrapper(S,A)))) &m.
 have how:=ow_base_hardness (SecOWAuxAdapter(SecOWReducer(AHWrapper(S,A)))) &m.
 have hex:=inj_uniform_existence_bound
  (INJShortSolver(SecINJAuxAdapter(SecINJReducer(AHWrapper(S,A))))) &m.
 have hshort:Pr[INJShortRelationGame
  (INJShortSolver(SecINJAuxAdapter(SecINJReducer(AHWrapper(S,A))))).run()@&m:res]
  <=1%r/(2%r^244).
 + have hn:=sr_uniform_bad_mass_244;smt().
 exact(ah_hardness_sum _ _ _ _ _ _ _ _ _ ow_alpha_g_positive hc hinj how hshort).
qed.
