require import AllCore IntDiv Distr.
from Jasmin require import JWord JModel_x86.

require import Array768 WArray1536 NTRUPlus768NTTRadix2_4.
require import NTRUPlus768BasemulProof.

op block : int = 4.
op double_block : int = 8.
op nblocks : int = 96.

