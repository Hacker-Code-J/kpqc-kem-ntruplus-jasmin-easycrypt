lemma radix2_4_mul_i16_functional (a0 b0 : W16.t) :
  hoare [NTRUPlus768NTTRadix2_4.M.__mul_i16 :
    a = a0 /\ b = b0 ==> res = mul_i16 a0 b0].
proof.
  proc; auto => />.
qed.

lemma radix2_4_montgomery_reduce_functional (a0 : W32.t) :
  hoare [NTRUPlus768NTTRadix2_4.M.__montgomery_reduce :
    a = a0 ==> res = montgomery_reduce a0].
proof.
  proc; auto => />.
qed.

lemma radix2_4_barrett_reduce_functional (a0 : W16.t) :
  hoare [NTRUPlus768NTTRadix2_4.M.__barrett_reduce :
    a = a0 ==> res = barrett_reduce a0].
proof.
  proc; auto => />.
qed.

lemma radix2_4_prefix_zero
    (p : W16.t Array768.t) (base : int) (z : W16.t) :
  0 <= base <= 768 =>
  radix2_4_prefix_spec p base 0 z = p.
proof.
  move=> Hbase.
  apply Array768.tP => j Hj.
  rewrite /radix2_4_prefix_spec Array768.initiE 1:Hj.
  smt().
qed.

lemma radix2_4_prefix_curr0
    (p : W16.t Array768.t) (base upto : int) (z : W16.t) :
  0 <= base =>
  0 <= upto < block =>
  base + block + upto < 768 =>
  (radix2_4_prefix_spec p base upto z).[base + upto] = p.[base + upto].
proof.
  move=> Hbase Hupto Hbound.
  rewrite /radix2_4_prefix_spec Array768.initiE 1:/#.
  smt().
qed.

lemma radix2_4_prefix_curr1
    (p : W16.t Array768.t) (base upto : int) (z : W16.t) :
  0 <= base =>
  0 <= upto < block =>
  base + block + upto < 768 =>
  (radix2_4_prefix_spec p base upto z).[base + block + upto] =
    p.[base + block + upto].
proof.
  move=> Hbase Hupto Hbound.
  rewrite /radix2_4_prefix_spec Array768.initiE 1:/#.
  smt().
qed.

lemma radix2_4_prefix_step
    (p : W16.t Array768.t) (base upto : int) (z : W16.t) :
  0 <= base =>
  0 <= upto < block =>
  base + block + upto < 768 =>
  (radix2_4_prefix_spec p base upto z)
    .[base + upto <- (radix2_4_pair_at p base z upto).`1]
    .[base + block + upto <- (radix2_4_pair_at p base z upto).`2] =
  radix2_4_prefix_spec p base (upto + 1) z.
proof.
  move=> Hbase Hupto Hbound.
  apply Array768.tP => j Hj.
  rewrite /radix2_4_prefix_spec.
  rewrite Array768.initiE 1:Hj.
  case (j = base + upto) => [-> | Hneq0].
  + by rewrite !Array768.get_setE; smt().
  case (j = base + block + upto) => [-> | Hneq1].
  + by rewrite !Array768.get_setE; smt().
  rewrite !Array768.get_setE.
  + smt().
  + smt().
  rewrite Array768.initiE 1:Hj.
  smt().
qed.

lemma radix2_4_block_functional
    (rp0 : W16.t Array768.t) (base0 : int) (z0 : W16.t) :
  valid_base base0 =>
  hoare [NTRUPlus768NTTRadix2_4.M.__radix2_4_block :
    rp = rp0 /\ base = W64.of_int base0 /\ zeta_0 = z0 ==>
    res = radix2_4_block_spec rp0 base0 z0].
proof.
  move=> Hvalid.
  have [Hbase Hbound] := valid_base_bounds base0 Hvalid.
  proc.
  seq 3 :
    (rp = radix2_4_prefix_spec rp0 base0 0 z0 /\
     i = W64.of_int base0 /\
     stop = W64.of_int base0 + W64.of_int block /\
     zeta_0 = z0).
  + auto => />.
    rewrite radix2_4_prefix_zero 1:/# /block.
    smt().
  while (base0 <= W64.to_uint i <= base0 + block /\
         stop = W64.of_int base0 + W64.of_int block /\
         zeta_0 = z0 /\
         rp = radix2_4_prefix_spec rp0 base0 (W64.to_uint i - base0) z0); last first.
  + skip => &hr [Hrp [Hi [Hstop Hzeta]]].
    split.
    + split.
      - rewrite Hi W64.to_uintK_small 1:/#.
        smt(W64.to_uint_cmp).
      split; first exact Hstop.
      split; first exact Hzeta.
      rewrite Hrp.
      rewrite Hi W64.to_uintK_small 1:/#.
      smt().
    move=> i1 rp1 Hexit [Hi1 [_ [_ Hrp1]]].
    rewrite W64.ultE /= Hstop
      (valid_base_stop_to_uint base0 Hvalid) in Hexit.
    have Hiend : W64.to_uint i1 = base0 + block by smt().
    rewrite /radix2_4_block_spec.
    smt().
  inline NTRUPlus768NTTRadix2_4.M.__mul_i16
         NTRUPlus768NTTRadix2_4.M.__montgomery_reduce
         NTRUPlus768NTTRadix2_4.M.__barrett_reduce.
  auto => /> &hr Hi Hrp Hloop.
  rewrite W64.ultE /= in Hloop.
  rewrite (valid_base_stop_to_uint base0 Hvalid) in Hloop.
  have Hidx : 0 <= W64.to_uint i{hr} - base0 < block by smt().
  have Hcurri : W64.to_uint i{hr} = base0 + (W64.to_uint i{hr} - base0)
    by smt().
  have Hget0 :
      (radix2_4_prefix_spec rp0 base0 (W64.to_uint i{hr} - base0) z0)
        .[W64.to_uint i{hr}] = rp0.[W64.to_uint i{hr}].
  + have Hcurr :
        (radix2_4_prefix_spec rp0 base0 (W64.to_uint i{hr} - base0) z0)
          .[base0 + (W64.to_uint i{hr} - base0)] =
        rp0.[base0 + (W64.to_uint i{hr} - base0)].
    + apply radix2_4_prefix_curr0; smt().
    move: Hcurr.
    by rewrite -Hcurri.
  have Hget1 :
      (radix2_4_prefix_spec rp0 base0 (W64.to_uint i{hr} - base0) z0)
        .[W64.to_uint i{hr} + block] =
      rp0.[W64.to_uint i{hr} + block].
  + have Hcurr :
        (radix2_4_prefix_spec rp0 base0 (W64.to_uint i{hr} - base0) z0)
          .[base0 + block + (W64.to_uint i{hr} - base0)] =
        rp0.[base0 + block + (W64.to_uint i{hr} - base0)].
    + apply radix2_4_prefix_curr1; smt().
    have Hcurri1 :
        W64.to_uint i{hr} + block =
        base0 + block + (W64.to_uint i{hr} - base0) by smt().
    move: Hcurr.
    by rewrite -Hcurri1.
  have Hnext : W64.to_uint (i{hr} + W64.one) - base0 =
      (W64.to_uint i{hr} - base0) + 1.
  + rewrite W64.to_uintD_small /=; smt(W64.to_uint_cmp).
  have Haddr : W64.to_uint (i{hr} + W64.of_int block) =
      W64.to_uint i{hr} + block.
  + rewrite W64.to_uintD_small /= /block; smt(W64.to_uint_cmp).
  have Hspec_addr :
      base0 + block + (W64.to_uint i{hr} - base0) =
      W64.to_uint i{hr} + block by smt().
  have Hstep :
      (radix2_4_prefix_spec rp0 base0 (W64.to_uint i{hr} - base0) z0)
        .[base0 + (W64.to_uint i{hr} - base0) <-
          (radix2_4_pair_at rp0 base0 z0 (W64.to_uint i{hr} - base0)).`1]
        .[base0 + block + (W64.to_uint i{hr} - base0) <-
          (radix2_4_pair_at rp0 base0 z0 (W64.to_uint i{hr} - base0)).`2] =
      radix2_4_prefix_spec rp0 base0
        ((W64.to_uint i{hr} - base0) + 1) z0.
  + apply radix2_4_prefix_step; smt().
  split.
  + rewrite W64.to_uintD_small /=; smt(W64.to_uint_cmp).
  rewrite Hnext.
  rewrite -Hstep.
  rewrite /radix2_4_pair_at /radix2_4_pair /radix2_4_mul /block.
  rewrite Hget0 Haddr Hget1.
  rewrite -Hcurri Hspec_addr.
  rewrite !radix2_4_truncate_sigext_sub !radix2_4_truncate_sigext_add.
  rewrite /barrett_reduce /mul_i16 /montgomery_reduce.
  rewrite /=.
  apply Array768.set_set_swap.
