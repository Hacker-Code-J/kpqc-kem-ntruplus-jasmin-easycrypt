namespace Product {
  require "poly_basemul.jazz"
}

namespace Inverse {
  require "invntt.jazz"
}

namespace Ternary {
  require "crepmod3.jazz"
}

param int NTRUPLUS_N = 768;

// First normal Decaps calculation only. The three external regions are
// disjoint, u16-aligned 1536-byte buffers; cp and fp are initialized.
// Canonical decoder outputs have coefficients in [0,3457). All values are
// secret and the computation discloses no status or other predicate.
#[safety =
   { requires = is_arr_init(cp,0,2 * NTRUPLUS_N) &&
                is_arr_init(fp,0,2 * NTRUPLUS_N)
   , ensures = is_arr_init(rp,0,2 * NTRUPLUS_N)
   }
]
#[ct = "secret × secret × secret → secret"]
#[sct="
{ ptr: transient, val: secret } ×
{ ptr: transient, val: secret } ×
{ ptr: transient, val: secret } →
{ ptr: public, val: secret }
"]
export fn jade_ntruplus_ntruplus768_amd64_ref_decap_candidate(
  reg mut ptr u16[NTRUPLUS_N] rp,
  reg const ptr u16[NTRUPLUS_N] cp,
  reg const ptr u16[NTRUPLUS_N] fp) -> reg ptr u16[NTRUPLUS_N]
{
  stack u16[NTRUPLUS_N] product;
  stack u16[NTRUPLUS_N] inverse;
  reg ptr u16[NTRUPLUS_N] productp;
  reg ptr u16[NTRUPLUS_N] inversep;

  inline int i;

  // Fixed-index initialization makes every private array cell initialized
  // before the work arrays are accessed through their pointer views.
  _ = #init_msf();
  for i = 0 to NTRUPLUS_N {
    product[i] = 0;
    inverse[i] = 0;
  }

  productp = product[0:NTRUPLUS_N];
  inversep = inverse[0:NTRUPLUS_N];
  #[inline] productp = Product::jade_ntruplus_ntruplus768_amd64_ref_poly_basemul(productp, cp, fp);
  #[inline] inversep = Inverse::jade_ntruplus_ntruplus768_amd64_ref_invntt(inversep, productp);
  #[inline] rp = Ternary::jade_ntruplus_ntruplus768_amd64_ref_poly_crepmod3(rp, inversep);

  return rp;
}
