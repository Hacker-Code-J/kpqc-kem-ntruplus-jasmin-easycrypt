inline fn __mul_i16(reg u16 a b) -> reg u32
{
  reg u32 ad;
  reg u32 bd;
  reg u32 c;

  ad = (32s) a;
  bd = (32s) b;
  c = ad * bd;
  return c;
}

inline fn __montgomery_reduce(reg u32 a) -> reg u16
{
  reg u16 t;
  reg u32 q;
  reg u32 td;
  reg u32 r;

  q = NTRUPLUS_Q;
  td = (32s) a;
  td *= NTRUPLUS_QINV;
  t = td;
  td = (32s) t;
  r = (32s) a;
  td *= q;
  r -= td;
  r >>s= 16;
  t = r;
  return t;
}

inline fn __barrett_reduce(reg u16 a) -> reg u16
{
  reg u16 t;
  reg u32 td;
  reg u32 v;
  reg u32 q;

  v = NTRUPLUS_BARRETT_V;
  td = (32s) a;
  td *= v;
  td += NTRUPLUS_BARRETT_BIAS;
  td >>s= 26;
  t = td;
  q = NTRUPLUS_Q;
  td = (32s) t;
  td *= q;
  t = td;
  t = a - t;
  return t;
}

