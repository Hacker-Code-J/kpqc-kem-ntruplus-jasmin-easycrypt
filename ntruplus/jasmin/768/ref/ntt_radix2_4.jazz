inline fn __radix2_4_block(
  reg mut ptr u16[NTRUPLUS_N] rp,
  reg u64 base,
  reg u16 zeta) -> reg ptr u16[NTRUPLUS_N]
{
  reg u16 low;
  reg u16 high;
  reg u16 t;
  reg u16 sum;
  reg u16 diff;
  reg u32 acc;
  reg u32 wd;
  reg u32 td;
  reg u64 i;
  reg u64 stop;

  i = base;
  stop = base;
  stop += 4;
  while (i < stop) {
    low = rp[i];
    high = rp[i + 4];
    acc = __mul_i16(zeta, high);
    t = __montgomery_reduce(acc);

    wd = (32s) low;
    td = (32s) t;
    wd -= td;
    diff = wd;
    wd = (32s) low;
    td = (32s) t;
    wd += td;
    sum = wd;

    rp[i + 4] = __barrett_reduce(diff);
    rp[i] = __barrett_reduce(sum);
    i += 1;
  }

  return rp;
}

