inline fn __invntt_radix2_8_block(
  reg mut ptr u16[NTRUPLUS_N] rp,
  reg u64 base,
  reg u16 zeta) -> reg ptr u16[NTRUPLUS_N]
{
  reg u16 low;
  reg u16 high;
  reg u16 sum;
  reg u16 diff;
  reg u16 prod;
  reg u32 acc;
  reg u64 i;
  reg u64 stop;
  reg u32 wd;
  reg u32 td;

  i = base;
  stop = base;
  stop += 8;
  while (i < stop) {
    low = rp[i];
    high = rp[i + 8];

    wd = (32s) low;
    td = (32s) high;
    wd += td;
    sum = wd;

    wd = (32s) high;
    td = (32s) low;
    wd -= td;
    diff = wd;

    sum = __barrett_reduce(sum);
    acc = __mul_i16(zeta, diff);
    prod = __montgomery_reduce(acc);
    rp[i] = sum;
    rp[i + 8] = prod;
    i += 1;
  }

  return rp;
}

