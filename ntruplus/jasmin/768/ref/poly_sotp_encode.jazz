param int NTRUPLUS_N = 768;
param int NTRUPLUS_MSG_BYTES = NTRUPLUS_N / 8;
param int NTRUPLUS_RANDOM_BYTES = NTRUPLUS_N / 4;

#[safety =
   { requires = is_arr_init(msg,0,NTRUPLUS_MSG_BYTES) && is_arr_init(buf,0,NTRUPLUS_RANDOM_BYTES)
   , ensures = is_arr_init(rp,0,2 * NTRUPLUS_N)
   }
]
#[ct = "secret × secret × secret → secret"]
#[sct="
{ ptr: transient, val: secret } ×
{ ptr: transient, val: secret } ×
{ ptr: transient, val: secret } →
{ ptr: public, val: secret }
"]
export fn jade_ntruplus_ntruplus768_amd64_ref_poly_sotp_encode(
  reg mut ptr u16[NTRUPLUS_N] rp,
  reg const ptr u8[NTRUPLUS_MSG_BYTES] msg,
  reg const ptr u8[NTRUPLUS_RANDOM_BYTES] buf) -> reg ptr u16[NTRUPLUS_N]
{
  reg u64 k;
  reg u64 i;
  reg u8 j;
  reg u8 head;
  reg u16 t1;
  reg u16 t2;

  _ = #init_msf();
  k = 0;
  while (k < NTRUPLUS_N) {
    i = k;
    i >>= 3;
    j = (8u) k;
    j &= 7;
    head = buf[i];
    head ^= msg[i];
    t1 = (16u) head;
    t2 = (16u) buf[i + NTRUPLUS_N / 8];
    _, _, _, _, _, t1 = #SHR_16(t1, j);
    _, _, _, _, _, t2 = #SHR_16(t2, j);
    t1 &= 1;
    t2 &= 1;
    t1 -= t2;
    rp[k] = t1;
    k += 1;
  }
  return rp;
}
